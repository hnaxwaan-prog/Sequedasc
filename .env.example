# Copy this file to .env and fill in your own values.

# Web address of the site (used for links in emails), e.g. https://hlattorney.mv
PUBLIC_URL=http://localhost:3000
PORT=3000

# Password for the attorney dashboard at /admin (at least 8 characters)
ADMIN_PASSWORD=1234
# Optional long random text used to sign the dashboard login cookie (keep it secret).
# If empty, it is derived from ADMIN_PASSWORD.
SESSION_SECRET=

# Where new-request and payment-slip alerts are sent
LAWYER_EMAIL=

# Outgoing email (SMTP). Without these, emails are saved to data/outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HL Attorney at Law <no-reply@example.com>"

# Firm details shown on the website and in emails
FIRM_PHONE=+960 7911497
FIRM_WHATSAPP=9607911497
FIRM_EMAIL=info@hlattorney.mv
FIRM_ADDRESS=Malé, Republic of Maldives
FIRM_HOURS=Sunday – Thursday, 9:00 AM – 5:00 PM

# Bank account clients pay the attestation fee into
BANK_NAME=Bank of Maldives
BANK_ACCOUNT_NAME=HL Attorney at Law
BANK_ACCOUNT_NUMBER=0000000000000
ATTESTATION_CURRENCY=MVR
# Fee pre-filled when approving (the attorney can change it per request)
ATTESTATION_FEE=10
# true = the attorney must confirm the slip before the client can download
REQUIRE_PAYMENT_VERIFICATION=false

# Node server only: folder for uploaded documents and the request database (must be kept between restarts).
# On EdgeOne Pages everything is kept in EdgeOne Blob storage instead.
DATA_DIR=./data
# Set to true when running behind a reverse proxy (Nginx, Render, Railway…)
TRUST_PROXY=false
